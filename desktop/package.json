{
  "name": "rune-desktop",
  "productName": "Rune",
  "version": "2.0.0",
  "description": "Rune for Windows \u2013 a private, offline-first music and music-video player.",
  "main": "main.js",
  "author": "Rune contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.rune.music",
    "productName": "Rune",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "build/icon.png",
      "build/thumb/*.png",
      "app/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Rune",
      "artifactName": "Rune-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Rune-Portable.${ext}"
    }
  }
}
